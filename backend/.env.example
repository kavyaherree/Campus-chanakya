# ==============================================================================
# CampusChanakya - Spring Boot Backend Environment Template (.env.example)
# ==============================================================================

# AI & LLM Provider API Keys
GOOGLE_API_KEY1=YOUR_GEMINI_API_KEY_HERE
GOOGLE_API_KEY2=
GOOGLE_API_KEY3=
OPENAI_API_KEY1=YOUR_OPENAI_API_KEY_HERE
OPENAI_API_KEY2=
ANTHROPIC_API_KEY=

# Model Selection
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Server Settings
HOST=127.0.0.1
PORT=8080
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration (Default: Embedded H2 database)
SPRING_DATASOURCE_URL=jdbc:h2:mem:campus_chanakya;DB_CLOSE_DELAY=-1;MODE=MySQL;DATABASE_TO_LOWER=TRUE;CASE_INSENSITIVE_IDENTIFIERS=TRUE
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.H2Dialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# MySQL Example:
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/campus_chanakya?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=your_password
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
# SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.MySQLDialect

# Security & JWT Configuration
CAMPUSCHANAKYA_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
CAMPUSCHANAKYA_JWT_EXPIRATION_MS=86400000

# SMTP Email Dispatch Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM_NAME=CampusChanakya
SMTP_LOGIN=

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_16_character_app_password
